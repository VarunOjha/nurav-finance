# ==============================================================================
# .env.reference - catalog of every key Nurav Finance reads. Placeholders only.
#
# FILES   .env  = nurav-creds bootstrap (2 keys) + optional local knobs.
#         Copy this file to .env and fill in Section 1. .env is gitignored.
#
# TAGS    [SET] you must set it    [DEFAULT] the default is fine
#
# RULES   Section 3 lives in the nurav-creds portal, NOT in any .env file.
#         The app refuses to boot if a Section 3 key is missing from the vault.
#         New key: add here first -> portal -> settings.<key> in backend/config.py.
#         Never commit real values; never log or print fetched secrets.
# ==============================================================================


# ------------------------------------------------------------------------------
# SECTION 1 - bootstrap: the only required contents of .env
# ------------------------------------------------------------------------------
# [SET] URL of the vault's secrets endpoint for the 'nurav-finance' app.
NURAV_CREDS_ENDPOINT=https://nurav-creds.nuravapp.com/api/v1/secrets
# [SET] Portal TOKENS tab, shown exactly once.
NURAV_CREDS_TOKEN=


# ------------------------------------------------------------------------------
# SECTION 2 - non-secret local knobs (optional; not vaulted)
# ------------------------------------------------------------------------------
# [DEFAULT] Host port the app is published on: http://localhost:8020
#PORT=8020
# [DEFAULT] Compose bind address; 0.0.0.0 exposes the app to the LAN.
#BIND_HOST=127.0.0.1
# [DEFAULT] Login session length in minutes (12 hours).
#JWT_EXPIRE_MINUTES=720


# ==============================================================================
# SECTION 3 - VAULT KEYS: populate these in the nurav-creds portal.
# The app fetches this whole map at boot; none of it belongs in .env.
# ==============================================================================

# [SET] Neon Postgres connection string for the new 'nurav-finance' project.
#       Neon console -> Connection details -> "psycopg2" style, keep sslmode.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# [SET] Signs login tokens. Random, at least 32 characters. Generate with:
#       python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# [SET] Fernet key that encrypts account numbers at rest. Generate with:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#       BACK THIS UP somewhere safe: losing it makes stored account numbers
#       unrecoverable (everything else keeps working). Never rotate it by
#       simply replacing it - stored numbers would stop decrypting.
# ACCOUNT_NUMBER_KEY=
